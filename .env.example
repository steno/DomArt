# Copy to .env.local for local development (optional)

# Leave empty for local `next dev` and `next build` at root.
# GitHub Actions sets this automatically to /<repo-name> for project pages.
NEXT_PUBLIC_BASE_PATH=

# Public site URL (used for Open Graph metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp order number (digits only, with country code)
# Contact, custom-width, and configuration inquiries open WhatsApp with a pre-filled message.
NEXT_PUBLIC_WHATSAPP_NUMBER=17542133764
